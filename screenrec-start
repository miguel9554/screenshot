#!/bin/bash

PIDFILE=/tmp/screenrec.pid

if [ -f "$PIDFILE" ]; then
    if grep -q '^pid=' "$PIDFILE"; then
        . "$PIDFILE"
    else
        pid=$(cat "$PIDFILE")
    fi

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "Recording already in progress (PID $pid)"
        exit 1
    fi

    echo "Removing stale recording state."
    rm "$PIDFILE"
fi

TIMESTAMP=$(date +%Y-%m-%d_%H.%M:%S)
OUTFILE="$HOME/Videos/screen-recordings/recording-$TIMESTAMP.mp4"
mkdir -p "$HOME/Videos/screen-recordings"

GEOMETRY=$(slop -f "%x %y %w %h")
read -r x y w h <<< "$GEOMETRY"

ffmpeg -f x11grab -s "${w}x${h}" -i ":0.0+${x},${y}" \
       "$OUTFILE" &

{
    echo "pid=$!"
    echo "outfile=$OUTFILE"
} > "$PIDFILE"
echo "Recording started (PID $!) → $OUTFILE"
