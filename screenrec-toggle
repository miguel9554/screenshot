#!/bin/bash

PIDFILE=/tmp/screenrec.pid

if [ -f "$PIDFILE" ]; then
    if grep -q '^pid=' "$PIDFILE"; then
        . "$PIDFILE"
    else
        pid=$(cat "$PIDFILE")
    fi
fi

if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    exec screenrec-stop
else
    [ -f "$PIDFILE" ] && rm "$PIDFILE"
    exec screenrec-start
fi
